# Copie para .env (local) e configure as mesmas chaves nas variáveis de ambiente da Netlify.
# Nunca coloque valores reais neste arquivo.

# Brevo: Configurações > SMTP & API > Chaves de API
BREVO_API_KEY=

# Cloudflare Turnstile: chave secreta do widget (a chave pública fica em src/content/site.yaml)
TURNSTILE_SECRET_KEY=
