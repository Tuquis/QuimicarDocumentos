---
// 7.8 Combo em destaque. Economia só com os três preços válidos (seção 4.2).
import { Picture } from 'astro:assets';
import Selo from '../Selo.astro';
import Preco from '../Preco.astro';
import BotaoProduto from '../BotaoProduto.astro';
import Icone from '../Icone.astro';
import { getProdutos, imagem, linkLegal } from '@/lib/conteudo';
import { formatarPreco, vendavel } from '@/lib/produtos';

const { porId, economia } = await getProdutos();
const p = porId.completo;
const reembolso = await linkLegal('politica-de-reembolso');
const compravel = vendavel(p);
---
<section id="completo" aria-labelledby="titulo-completo" class="secao bg-branco" data-ver-colecao="completo">
  <div class="container-lp">
    <div class="fundo-escuro relative overflow-hidden rounded-[24px] bg-petroleo text-branco shadow-cartao">
      <div aria-hidden="true" class="pointer-events-none absolute -top-24 -right-24 size-80 rounded-full bg-turquesa/20 blur-3xl"></div>
      <div aria-hidden="true" class="pointer-events-none absolute -bottom-24 -left-24 size-72 rounded-full bg-laranja/20 blur-3xl"></div>

      <div class="relative grid gap-8 p-6 md:grid-cols-[1.2fr_1fr] md:gap-12 md:p-12">
        <div>
          {p.selo && <Selo tipo="destaque">{p.selo}</Selo>}
          <h2 id="titulo-completo" class="h2 mt-4 text-branco">QUIMICAR COMPLETO: duas coleções, uma jornada</h2>
          <p class="mt-4 text-branco/90">
            Da compreensão dos conteúdos à autonomia para resolver questões. No <strong class="text-turquesa">CONECTA</strong>, você constrói sua base, visualiza os conceitos e compreende suas aplicações. No <strong class="text-laranja">APLICA</strong>, aprende a investigar questões oficiais do ENEM, aprofundar a ciência envolvida, enfrentar desafios inéditos e avaliar seu próprio raciocínio.
          </p>

          <ul class="mt-6 grid gap-2.5 sm:grid-cols-2" aria-label="Composição do QUIMICAR COMPLETO">
            {p.composicao.map((c) => (
              <li class="flex items-center gap-3 rounded-xl bg-branco/[0.07] px-3 py-2.5 ring-1 ring-branco/10">
                <span class="font-titulo text-2xl font-extrabold text-dourado">{c.quantidade}</span>
                <span class="text-[15px] leading-5">{c.item}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="flex flex-col justify-center">
          <div class="relative mx-auto hidden h-56 w-full max-w-xs md:block" aria-hidden="true">
            <Picture src={imagem('amostras/aplica-q100-enem2025/raio-x-1.webp')} alt="" formats={['avif', 'webp']} fallbackFormat="jpg" widths={[300]} sizes="180px" quality={70} loading="lazy" class="absolute top-4 left-4 w-40 -rotate-6 rounded-md shadow-xl" />
            <Picture src={imagem('amostras/conecta-acidos-e-bases/mapa.webp')} alt="" formats={['avif', 'webp']} fallbackFormat="jpg" widths={[300]} sizes="180px" quality={70} loading="lazy" class="absolute top-0 right-4 w-40 rotate-3 rounded-md shadow-xl" />
          </div>

          <div class="mt-6 rounded-2xl bg-branco p-6 text-cinza-escuro">
            <Preco produto={p} grande />
            {economia && (
              <p class="mt-3 text-[15px] leading-6">
                Separadas, as coleções somam {formatarPreco(economia.somaSeparadas)}. No COMPLETO, você paga {formatarPreco(economia.precoCombo)}.
              </p>
            )}
            {!compravel && p.status !== 'indisponivel' && (
              <p class="text-[15px] leading-6">Comece pela amostra grátis: um conjunto completo de cada coleção para conhecer a proposta.</p>
            )}
            <BotaoProduto produto={p} class="mt-5 w-full" />
            {compravel && (
              <ul class="mt-4 space-y-1.5 text-sm text-cinza-medio">
                <li class="flex items-center gap-2"><Icone nome="cadeado" class="size-4 text-petroleo" /> Pagamento processado pela plataforma de checkout</li>
                <li class="flex items-center gap-2"><Icone nome="relogio" class="size-4 text-petroleo" /> Acesso após a confirmação do pagamento</li>
                {reembolso && <li class="flex items-center gap-2"><Icone nome="escudo" class="size-4 text-petroleo" /> <a href={reembolso} class="underline underline-offset-2 hover:text-petroleo">Política de reembolso</a></li>}
              </ul>
            )}
            <p class="mt-4 text-center text-xs text-cinza-medio">Materiais digitais em PDF para leitura e impressão pessoal.</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
