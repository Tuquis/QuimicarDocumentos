---
// 7.4 O método + componente interativo "Método na prática" (Questão 100 · ENEM 2025).
// Sem JS: as cinco etapas aparecem em lista. Com JS: abas/stepper.
import TituloSecao from '../TituloSecao.astro';
import Selo from '../Selo.astro';
import Icone from '../Icone.astro';
import { getAmostra } from '@/lib/conteudo';

const { questao_base: q } = await getAmostra('aplica-q100-enem2025');
if (!q) throw new Error('questao_base ausente em aplica-q100-enem2025.yaml');

// Cores por etapa (seção 6.3). Chips com fundo; texto sempre com contraste AA.
const etapas = [
  { nome: 'VISUALIZE', icone: 'olho', resumo: 'Observe as informações relevantes.', chip: 'bg-petroleo text-branco', texto: 'text-petroleo', borda: 'border-petroleo', sel: 'aria-selected:border-petroleo' },
  { nome: 'ENTENDA', icone: 'livro', resumo: 'Compreenda o problema.', chip: 'bg-turquesa text-petroleo', texto: 'text-turquesa-texto', borda: 'border-turquesa', sel: 'aria-selected:border-turquesa' },
  { nome: 'CONECTE', icone: 'conexao', resumo: 'Conecte conhecimentos.', chip: 'bg-laranja text-petroleo', texto: 'text-laranja-texto', borda: 'border-laranja', sel: 'aria-selected:border-laranja' },
  { nome: 'APLIQUE', icone: 'alvo', resumo: 'Aplique os conceitos.', chip: 'bg-turquesa text-petroleo', texto: 'text-turquesa-texto', borda: 'border-turquesa', sel: 'aria-selected:border-turquesa' },
  { nome: 'ACERTE', icone: 'trofeu', resumo: 'Chegue a uma resposta fundamentada.', chip: 'bg-laranja text-petroleo', texto: 'text-laranja-texto', borda: 'border-laranja', sel: 'aria-selected:border-laranja' },
] as const;
const textoEtapa = (nome: string) => q.metodo.find((m) => m.etapa === nome)?.texto ?? '';
---
<section id="metodo" aria-labelledby="titulo-metodo" class="secao bg-branco">
  <div class="container-lp">
    <TituloSecao id="titulo-metodo" rotulo="Como funciona" centralizado>
      Um método visual em cinco etapas
      <p slot="intro">
        O Método Visual QUIMICAR orienta você a observar as informações relevantes, compreender o problema, conectar conhecimentos, aplicar os conceitos e chegar a uma resposta fundamentada.
      </p>
    </TituloSecao>

    <!-- Trilha das 5 etapas -->
    <ol class="mx-auto grid max-w-5xl grid-cols-1 gap-3 sm:grid-cols-5 sm:gap-2">
      {etapas.map((e, i) => (
        <li class="revelar relative flex items-center gap-3 rounded-xl bg-cinza-claro/50 p-3 sm:flex-col sm:bg-transparent sm:p-0 sm:text-center">
          {i > 0 && <span aria-hidden="true" class="absolute top-7 -left-1 hidden h-0.5 w-[calc(100%-56px)] -translate-x-1/2 bg-gradient-to-r from-cinza-claro to-cinza-medio/40 sm:block" />}
          <span class:list={['relative flex size-14 shrink-0 items-center justify-center rounded-full shadow-md', e.chip]}>
            <Icone nome={e.icone} class="size-6" />
          </span>
          <span>
            <span class:list={['block font-titulo text-[15px] font-extrabold tracking-[0.08em]', e.texto]}>{i + 1}. {e.nome}</span>
            <span class="block text-sm leading-5 text-cinza-escuro sm:mt-1">{e.resumo}</span>
          </span>
        </li>
      ))}
    </ol>

    <!-- Método na prática -->
    <div class="mt-14 overflow-hidden rounded-[20px] bg-petroleo shadow-cartao md:mt-20">
      <div class="grid lg:grid-cols-[1fr_1.1fr]">
        <div class="fundo-escuro min-w-0 p-5 text-branco md:p-8">
          <p class="rotulo text-turquesa">Método na prática</p>
          <Selo tipo="oficial" class="mt-3 max-w-full bg-branco/10 ring-1 ring-branco/20">{q.identificacao}</Selo>
          <p class="mt-4 text-[15px] leading-6 text-branco/85 md:text-base md:leading-7">{q.texto_resumido}</p>
          <p class="mt-2 text-xs text-branco/75">{q.fonte}</p>
          <p class="mt-4 font-titulo text-lg leading-7 font-bold text-branco">{q.pergunta}</p>
          <ul class="mt-4 space-y-2" id="metodo-alternativas">
            {q.alternativas.map((a) => (
              <li
                data-letra={a.letra}
                class="flex items-center gap-3 rounded-lg border border-branco/15 px-3 py-2 text-[15px] text-branco/90 transition-colors data-[correta]:border-dourado data-[correta]:bg-dourado/15 data-[correta]:text-branco"
              >
                <span class="flex size-7 shrink-0 items-center justify-center rounded-full border border-branco/40 font-titulo text-sm font-bold">{a.letra}</span>
                {a.texto}
              </li>
            ))}
          </ul>
        </div>

        <div class="min-w-0 bg-branco p-5 md:p-8" id="metodo-pratica">
          <p class="font-titulo text-lg font-bold text-petroleo">Siga as cinco etapas:</p>
          <div role="tablist" aria-label="Etapas do método" class="scrollbar-oculta -mx-1 mt-4 hidden snap-x gap-2 overflow-x-auto px-1 pb-1 [.js_&]:flex" id="metodo-abas">
            {etapas.map((e, i) => (
              <button
                type="button"
                role="tab"
                id={`metodo-aba-${i}`}
                aria-controls={`metodo-painel-${i}`}
                aria-selected={i === 0 ? 'true' : 'false'}
                tabindex={i === 0 ? 0 : -1}
                class:list={['flex min-h-11 shrink-0 snap-start items-center gap-2 rounded-full border-2 border-cinza-claro px-3.5 font-titulo text-sm font-bold text-petroleo transition-colors aria-selected:text-petroleo', e.sel, 'aria-selected:bg-cinza-claro/60']}
              >
                <span class:list={['flex size-6 items-center justify-center rounded-full text-xs', e.chip]}>{i + 1}</span>
                {e.nome}
              </button>
            ))}
          </div>

          <div class="mt-4 space-y-3 [.js_&]:space-y-0">
            {etapas.map((e, i) => (
              <div
                id={`metodo-painel-${i}`}
                role="tabpanel"
                aria-labelledby={`metodo-aba-${i}`}
                data-etapa={e.nome}
                class:list={['rounded-xl border-l-4 bg-cinza-claro/40 p-4 md:p-5', e.borda, i > 0 && '[.js_&]:hidden']}
                tabindex="0"
              >
                <p class:list={['font-titulo text-sm font-extrabold tracking-[0.08em]', e.texto]}>{i + 1}. {e.nome}</p>
                <p class="mt-1 font-titulo text-xl leading-8 font-bold text-petroleo md:text-2xl">{textoEtapa(e.nome)}</p>
              </div>
            ))}
          </div>

          <div class="mt-3 hidden items-center justify-between gap-3 [.js_&]:flex">
            <button type="button" id="metodo-anterior" class="btn min-h-11 px-4 py-2 text-sm text-petroleo hover:bg-cinza-claro disabled:opacity-40" disabled>
              <span aria-hidden="true">←</span> Anterior
            </button>
            <p class="text-sm whitespace-nowrap text-cinza-medio" aria-live="polite" id="metodo-progresso">Etapa 1 de 5</p>
            <button type="button" id="metodo-proxima" class="btn btn-secundario min-h-11 px-4 py-2 text-sm">
              Próxima <span aria-hidden="true">→</span>
            </button>
          </div>

          <aside class="mt-6 rounded-xl border border-vermelho/30 bg-[#fdf1f0] p-4" aria-label="Não confunda">
            <p class="flex items-center gap-2 font-titulo text-sm font-extrabold tracking-wide text-[#b3261e] uppercase">
              <Icone nome="alerta" class="size-4" /> Não confunda
            </p>
            <p class="mt-1.5 text-[15px] leading-6">{q.nao_confunda}</p>
          </aside>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const abas = [...document.querySelectorAll<HTMLButtonElement>('#metodo-abas [role="tab"]')];
  const paineis = abas.map((a) => document.getElementById(a.getAttribute('aria-controls')!)!);
  const anterior = document.getElementById('metodo-anterior') as HTMLButtonElement;
  const proxima = document.getElementById('metodo-proxima') as HTMLButtonElement;
  const progresso = document.getElementById('metodo-progresso')!;
  const altCorreta = document.querySelector<HTMLElement>('#metodo-alternativas [data-letra="A"]');
  let atual = 0;

  const ir = (i: number, focar = false) => {
    atual = Math.max(0, Math.min(abas.length - 1, i));
    abas.forEach((a, j) => {
      const sel = j === atual;
      a.setAttribute('aria-selected', String(sel));
      a.tabIndex = sel ? 0 : -1;
      paineis[j].classList.toggle('hidden', !sel);
    });
    if (focar) abas[atual].focus();
    abas[atual].scrollIntoView({ block: 'nearest', inline: 'nearest', behavior: 'smooth' });
    anterior.disabled = atual === 0;
    proxima.disabled = atual === abas.length - 1;
    progresso.textContent = `Etapa ${atual + 1} de ${abas.length}`;
    altCorreta?.toggleAttribute('data-correta', atual === abas.length - 1);
  };

  abas.forEach((a, i) => {
    a.addEventListener('click', () => ir(i));
    a.addEventListener('keydown', (e) => {
      const mapa: Record<string, number> = { ArrowRight: atual + 1, ArrowLeft: atual - 1, Home: 0, End: abas.length - 1 };
      if (e.key in mapa) {
        e.preventDefault();
        ir(mapa[e.key], true);
      }
    });
  });
  anterior.addEventListener('click', () => ir(atual - 1));
  proxima.addEventListener('click', () => ir(atual + 1));
</script>
