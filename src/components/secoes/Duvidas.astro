---
// 7.12 Perguntas frequentes — <details>, acessível sem JS.
import TituloSecao from '../TituloSecao.astro';
import Icone from '../Icone.astro';
interface Props { perguntas: { pergunta: string; resposta: string }[] }
const { perguntas } = Astro.props;
---
<section id="duvidas" aria-labelledby="titulo-duvidas" class="secao bg-branco">
  <div class="container-lp max-w-3xl">
    <TituloSecao id="titulo-duvidas" rotulo="Dúvidas" centralizado>Perguntas frequentes</TituloSecao>
    <div class="divide-y divide-cinza-claro rounded-[16px] border border-cinza-claro">
      {perguntas.map((f) => (
        <details class="group">
          <summary class="flex min-h-14 cursor-pointer list-none items-center justify-between gap-4 px-5 py-4 font-titulo text-[17px] font-bold text-petroleo hover:bg-cinza-claro/40 [&::-webkit-details-marker]:hidden">
            {f.pergunta}
            <span class="flex size-8 shrink-0 items-center justify-center rounded-full bg-cinza-claro transition-transform group-open:rotate-45">
              <svg viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg>
            </span>
          </summary>
          <p class="px-5 pb-5 text-[16px] leading-7">{f.resposta}</p>
        </details>
      ))}
    </div>
  </div>
</section>
