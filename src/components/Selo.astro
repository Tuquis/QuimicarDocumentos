---
// Selos de identificação: questão oficial, questão autoral, destaque.
interface Props { tipo: 'oficial' | 'autoral' | 'destaque' | 'neutro'; class?: string }
const { tipo, class: classe = '' } = Astro.props;
const estilos = {
  oficial: 'bg-petroleo text-branco',
  autoral: 'bg-[#efe9f8] text-[#5b3a9c] ring-1 ring-roxo/30',
  destaque: 'bg-dourado text-petroleo',
  neutro: 'bg-cinza-claro text-petroleo',
};
const icone = { oficial: 'ENEM', autoral: null, destaque: null, neutro: null }[tipo];
---
<span class:list={['selo', estilos[tipo], classe]}>
  {tipo === 'oficial' && <span class="rounded bg-laranja px-1 text-[10px] leading-4 font-bold text-petroleo">{icone}</span>}
  {tipo === 'autoral' && <svg viewBox="0 0 24 24" class="size-3.5" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.38 3.62a1 1 0 0 1 3 3L7.37 18.64a2 2 0 0 1-.86.5l-2.87.84a.5.5 0 0 1-.62-.62l.84-2.87a2 2 0 0 1 .5-.86z"/></svg>}
  <slot />
</span>
