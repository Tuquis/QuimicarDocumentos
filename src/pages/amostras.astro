---
// 8.1 /amostras — destino das campanhas de "material grátis": formulário acima da dobra.
import Base from '@/layouts/Base.astro';
import FormAmostra from '@/components/FormAmostra.astro';
import PaginaAmostra from '@/components/PaginaAmostra.astro';
import FaixaMetodo from '@/components/FaixaMetodo.astro';
import Desafio from '@/components/secoes/Desafio.astro';
import Selo from '@/components/Selo.astro';
import { getAmostra } from '@/lib/conteudo';

const conecta = await getAmostra('conecta-acidos-e-bases');
const aplica = await getAmostra('aplica-q100-enem2025');
const paginasAplica = aplica.etapas.flatMap((e) => e.paginas);
---
<Base
  titulo="Amostra grátis de Química para o ENEM | QUIMICAR"
  descricao="Receba grátis por e-mail um mapa visual com questão comentada e um conjunto completo do APLICA com a Questão 100 do ENEM 2025. Materiais em PDF."
  cabecalho="enxuto"
>
  <section id="amostra" aria-labelledby="titulo-amostras" class="fundo-escuro relative overflow-hidden bg-petroleo pt-6 pb-12 md:py-16">
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 bg-[radial-gradient(40rem_20rem_at_100%_0%,rgb(0_184_217/0.18),transparent_70%)]"></div>
    <div class="container-lp relative grid gap-6 md:grid-cols-[1fr_1.1fr] md:items-center md:gap-12">
      <div class="text-branco">
        <p class="rotulo text-turquesa">Amostra grátis · PDF por e-mail</p>
        <h1 id="titulo-amostras" class="mt-2 text-[28px] leading-[34px] font-extrabold text-branco md:text-5xl md:leading-[58px]">Experimente a Química visual da QUIMICAR</h1>
        <p class="mt-3 text-branco/90 md:text-lg">Veja uma prévia ou receba gratuitamente um conjunto completo para estudar e conhecer a proposta.</p>
      </div>
      <FormAmostra id="form-amostra-lp" />
    </div>
  </section>

  <section aria-labelledby="titulo-recebe" class="secao bg-branco">
    <div class="container-lp">
      <h2 id="titulo-recebe" class="h2 text-center">O que você recebe</h2>
      <p class="mx-auto mt-3 max-w-2xl text-center">Toque nas páginas para ampliar.</p>

      <h3 class="mt-10 font-titulo text-xl font-extrabold">CONECTA · {conecta.titulo}</h3>
      <p class="mt-1 text-[15px]">{conecta.entrega_descricao}</p>
      <div data-galeria class="mt-5 grid grid-cols-2 gap-3 md:max-w-2xl md:gap-5">
        {conecta.paginas.map((p) => <PaginaAmostra caminho={p.imagem} alt={p.alt} legenda={p.legenda} sizes="(min-width: 768px) 320px, 45vw" />)}
      </div>

      <h3 class="mt-12 flex flex-wrap items-center gap-3 font-titulo text-xl font-extrabold">APLICA <Selo tipo="oficial">{aplica.identificacao}</Selo></h3>
      <p class="mt-1 text-[15px]">{aplica.entrega_descricao}</p>
      <div data-galeria class="mt-5 grid grid-cols-2 gap-3 sm:grid-cols-3 md:grid-cols-4 md:gap-5 lg:grid-cols-7">
        {paginasAplica.map((p) => <PaginaAmostra caminho={p.imagem} alt={p.alt} legenda={p.legenda} sizes="(min-width: 1024px) 150px, (min-width: 768px) 22vw, 45vw" />)}
      </div>
    </div>
  </section>

  <section aria-labelledby="titulo-metodo-curto" class="bg-cinza-claro/50 py-12 md:py-16">
    <div class="container-lp max-w-3xl text-center">
      <h2 id="titulo-metodo-curto" class="h2">Um método visual em cinco etapas</h2>
      <p class="mt-4">O Método Visual QUIMICAR orienta você a observar as informações relevantes, compreender o problema, conectar conhecimentos, aplicar os conceitos e chegar a uma resposta fundamentada.</p>
      <FaixaMetodo class="mt-6" />
    </div>
  </section>

  <Desafio idSecao="desafio-amostras" />

  <p class="container-lp pb-16 text-center">
    <a href="/#colecoes" class="font-titulo font-bold text-turquesa-texto underline underline-offset-4">Conhecer as coleções completas</a>
  </p>
</Base>

<script>
  import { iniciarLightbox } from '@/scripts/lightbox';
  iniciarLightbox();
</script>
