---
import Base from '@/layouts/Base.astro';
---
<Base titulo="Página não encontrada | QUIMICAR ENEM" descricao="A página procurada não existe." noindex>
  <section class="secao">
    <div class="container-lp max-w-2xl text-center">
      <p class="font-titulo text-6xl font-extrabold text-turquesa-texto">404</p>
      <h1 class="mt-4 text-[32px] leading-[38px] font-extrabold">Página não encontrada</h1>
      <p class="mt-4">O endereço pode ter mudado. Que tal voltar ao início ou ver as coleções?</p>
      <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
        <a href="/#colecoes" class="btn btn-primario">Ver coleções</a>
        <a href="/" class="btn btn-secundario">Voltar ao início</a>
      </div>
    </div>
  </section>
</Base>
